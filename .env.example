# HTTP server
HTTP_PORT=8083

# Database: DB_DRIVER selects the dialect, DATABASE_URL is the matching DSN.
DB_DRIVER=sqlite
# sqlite: a local file path is enough for dev/tests
DATABASE_URL=traccar-billing.db
# mysql: DATABASE_URL=user:password@tcp(127.0.0.1:3306)/traccar_billing?parseTime=true

# How often the scheduler re-syncs accounts and re-checks overdue subscriptions.
SYNC_INTERVAL=15m

# IANA timezone used for due dates, payment dates and the defaults shown in
# the UI. Leave it as UTC and a payment recorded at 7pm in Mexico is dated
# the next day. Example: America/Mexico_City
TIMEZONE=UTC

# Signs the browser session cookie that links a browser to a tenant.
# Generate with: openssl rand -hex 32
# Traccar server URL/email/password are NOT configured here: each tenant is
# added by an operator at http://localhost:8083/login, and only the
# resulting Traccar session cookie is ever persisted, never the password.
SESSION_SECRET=
